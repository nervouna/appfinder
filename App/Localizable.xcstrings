    "A shortcut needs ⌘, ⌥ or ⌃, or a function key.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A shortcut needs ⌘, ⌥ or ⌃, or a function key."
